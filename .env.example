# Template only; configure actual values in the server runtime.
# This custom Worker does not load .env files automatically.
# URL, publishable key and session key configure the optional AUTH adapter only.
SUPABASE_URL=https://dkiqgwziefazwrcieavq.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Generate a 32-byte random server secret (64 hexadecimal characters).
AUTH_SESSION_KEY=
# Business data still uses Cloudflare D1 (DB) and R2 (BUCKET).
# A PostgreSQL/Storage adapter has not been implemented yet.
# Optional local read-only connection check; never used by CI or the Worker.
# Supply through the local process environment, never commit an actual key.
SUPABASE_SECRET_KEY=
