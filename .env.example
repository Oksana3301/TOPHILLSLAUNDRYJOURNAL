# Template only; configure actual values in the server runtime.
# This custom Worker does not load .env files automatically.
# These settings activate the optional Supabase AUTH adapter only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Generate a 32-byte random server secret (64 hexadecimal characters).
AUTH_SESSION_KEY=
# Business data still uses Cloudflare D1 (DB) and R2 (BUCKET).
# A PostgreSQL/Storage adapter has not been implemented yet.
