# Template only. Runtime values are configured through Sites, not loaded from this file.
# Leave DATA_BACKEND unset for the original D1/R2 backend during migration.
# Activate supabase only after complete export/import and validation.
DATA_BACKEND=
SUPABASE_URL=https://dkiqgwziefazwrcieavq.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Existing session encryption key: preserve it during migration.
AUTH_SESSION_KEY=
# New 32-byte random backend credential. SHA-256 hash only in supabase-backend.json.
SUPABASE_BACKEND_TOKEN=
# Optional manual diagnostic only; never used by CI or the Worker.
SUPABASE_SECRET_KEY=
# Temporary migration window: pauses ALL API writes and scheduled catch-up.
TOP_HILLS_MIGRATION_MODE=
TOP_HILLS_MIGRATION_TOKEN=
TOP_HILLS_MIGRATION_EXPIRES=
